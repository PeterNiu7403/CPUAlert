<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="MoleWindows.Views.TrayHudWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Mole Windows 状态"
    mc:Ignorable="d">

    <Grid
        x:Name="HudRoot"
        Width="430"
        MinHeight="860"
        Padding="18"
        Background="#26312D"
        RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="HudTitleBar" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image
                Width="34"
                Height="34"
                Source="ms-appx:///Assets/Brand/mole-mark.svg" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="Mole Windows" />
                <TextBlock
                    FontFamily="{StaticResource MoleWindowsMonoFont}"
                    FontSize="12"
                    Foreground="{StaticResource MoleWindowsDimBrush}"
                    Text="{Binding SampleText}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource MoleWindowsCardBorderStyle}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="8">
                    <TextBlock
                        Foreground="{StaticResource MoleWindowsGoldBrush}"
                        Style="{StaticResource MoleWindowsLabelTextStyle}"
                        Text="健康度" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock
                            FontSize="42"
                            FontWeight="SemiBold"
                            Text="{Binding HealthScore}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource MoleWindowsGreenBrush}"
                            Text="{Binding HealthLabel}" />
                    </StackPanel>
                </StackPanel>
                <Border
                    Grid.Column="1"
                    Width="86"
                    Height="86"
                    BorderBrush="{StaticResource MoleWindowsGreenBrush}"
                    BorderThickness="9"
                    CornerRadius="43">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="24"
                        FontWeight="SemiBold"
                        Text="{Binding HealthScore}" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="12" RowSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Padding="14" Style="{StaticResource MoleWindowsCardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Foreground="{StaticResource MoleWindowsGreenBrush}" Style="{StaticResource MoleWindowsLabelTextStyle}" Text="CPU" />
                    <TextBlock FontSize="28" FontWeight="SemiBold" Text="{Binding CpuText}" />
                </StackPanel>
            </Border>
            <Border
                Grid.Column="1"
                Padding="14"
                Style="{StaticResource MoleWindowsCardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Foreground="{StaticResource MoleWindowsGoldBrush}" Style="{StaticResource MoleWindowsLabelTextStyle}" Text="内存" />
                    <TextBlock FontSize="28" FontWeight="SemiBold" Text="{Binding MemoryText}" />
                </StackPanel>
            </Border>
            <Border
                Grid.Row="1"
                Padding="14"
                Style="{StaticResource MoleWindowsCardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Foreground="{StaticResource MoleWindowsRedBrush}" Style="{StaticResource MoleWindowsLabelTextStyle}" Text="磁盘" />
                    <TextBlock FontSize="28" FontWeight="SemiBold" Text="{Binding DiskText}" />
                </StackPanel>
            </Border>
            <Border
                Grid.Row="1"
                Grid.Column="1"
                Padding="14"
                Style="{StaticResource MoleWindowsCardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Foreground="{StaticResource MoleWindowsBlueBrush}" Style="{StaticResource MoleWindowsLabelTextStyle}" Text="网络" />
                    <TextBlock
                        FontFamily="{StaticResource MoleWindowsMonoFont}"
                        FontSize="13"
                        Text="{Binding NetworkText}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource MoleWindowsCardBorderStyle}">
            <StackPanel Spacing="8">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Foreground="{StaticResource MoleWindowsGoldBrush}"
                        Style="{StaticResource MoleWindowsLabelTextStyle}"
                        Text="最近活动" />
                    <Button
                        Grid.Column="1"
                        Click="NavigationButton_Click"
                        Content="查看"
                        Style="{StaticResource MoleWindowsSecondaryPillButtonStyle}"
                        Tag="activity" />
                </Grid>
                <TextBlock
                    FontSize="18"
                    FontWeight="SemiBold"
                    Text="{Binding ActivityTitle}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    FontFamily="{StaticResource MoleWindowsMonoFont}"
                    FontSize="12"
                    Foreground="{StaticResource MoleWindowsDimBrush}"
                    Text="{Binding ActivityDetail}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="4" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Foreground="{StaticResource MoleWindowsMutedBrush}"
                Style="{StaticResource MoleWindowsLabelTextStyle}"
                Text="高占用进程" />
            <ListView
                Grid.Row="1"
                MaxHeight="150"
                ItemsSource="{Binding TopProcesses}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid MinHeight="30" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource MoleWindowsTextBrush}"
                                Text="{Binding Name}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="1"
                                FontFamily="{StaticResource MoleWindowsMonoFont}"
                                Foreground="{StaticResource MoleWindowsOrangeBrush}"
                                Text="{Binding CpuUsageText}" />
                            <TextBlock
                                Grid.Column="2"
                                FontFamily="{StaticResource MoleWindowsMonoFont}"
                                Foreground="{StaticResource MoleWindowsDimBrush}"
                                Text="{Binding WorkingSetText}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid Grid.Row="2" ColumnSpacing="8" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Button Click="NavigationButton_Click" Content="状态" Style="{StaticResource MoleWindowsPillButtonStyle}" Tag="status" />
                <Button Grid.Column="1" Click="NavigationButton_Click" Content="清理" Style="{StaticResource MoleWindowsSecondaryPillButtonStyle}" Tag="clean" />
                <Button Grid.Column="2" Click="NavigationButton_Click" Content="优化" Style="{StaticResource MoleWindowsSecondaryPillButtonStyle}" Tag="optimize" />
                <Button Grid.Row="1" Click="NavigationButton_Click" Content="历史" Style="{StaticResource MoleWindowsSecondaryPillButtonStyle}" Tag="history" />
                <Button Grid.Row="1" Grid.Column="1" Click="NavigationButton_Click" Content="活动" Style="{StaticResource MoleWindowsSecondaryPillButtonStyle}" Tag="activity" />
                <Button Grid.Row="1" Grid.Column="2" Click="NavigationButton_Click" Content="设置" Style="{StaticResource MoleWindowsSecondaryPillButtonStyle}" Tag="settings" />
            </Grid>
        </Grid>
    </Grid>
</Window>
