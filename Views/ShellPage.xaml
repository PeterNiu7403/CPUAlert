<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MoleWindows.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="#12100D"
    Loaded="ShellPage_Loaded"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="118" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="AppTitleBar" Background="Transparent" />

        <Grid
            Margin="24,48,162,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="BrandButton"
                Width="48"
                Height="48"
                Padding="0"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0"
                Click="TopNav_Click"
                Tag="status"
                ToolTipService.ToolTip="Mole Windows">
                <Image
                    Width="46"
                    Height="46"
                    Source="ms-appx:///Assets/Brand/mole-mark.svg"
                    Stretch="Uniform" />
            </Button>

            <Border
                Grid.Column="1"
                Width="690"
                Padding="8,5"
                Background="#171511"
                BorderBrush="#3A352E"
                BorderThickness="1"
                CornerRadius="28">
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="CleanNavButton"
                        HorizontalAlignment="Stretch"
                        Click="TopNav_Click"
                        Content="清理"
                        Style="{StaticResource MoleWindowsTopNavButtonStyle}"
                        Tag="clean" />
                    <Button
                        x:Name="AppsNavButton"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        Click="TopNav_Click"
                        Content="软件"
                        Style="{StaticResource MoleWindowsTopNavButtonStyle}"
                        Tag="apps" />
                    <Button
                        x:Name="OptimizeNavButton"
                        Grid.Column="2"
                        HorizontalAlignment="Stretch"
                        Click="TopNav_Click"
                        Content="优化"
                        Style="{StaticResource MoleWindowsTopNavButtonStyle}"
                        Tag="optimize" />
                    <Button
                        x:Name="AnalyzeNavButton"
                        Grid.Column="3"
                        HorizontalAlignment="Stretch"
                        Click="TopNav_Click"
                        Content="分析"
                        Style="{StaticResource MoleWindowsTopNavButtonStyle}"
                        Tag="analyze" />
                    <Button
                        x:Name="StatusNavButton"
                        Grid.Column="4"
                        HorizontalAlignment="Stretch"
                        Click="TopNav_Click"
                        Content="状态"
                        Style="{StaticResource MoleWindowsTopNavButtonStyle}"
                        Tag="status" />
                </Grid>
            </Border>

            <Border
                Grid.Column="2"
                Width="48"
                Height="48"
                Background="#171511"
                BorderBrush="#3A352E"
                BorderThickness="1"
                CornerRadius="24">
                <Button
                    x:Name="SettingsButton"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Click="TopNav_Click"
                    Style="{StaticResource MoleWindowsIconButtonStyle}"
                    Tag="settings"
                    ToolTipService.ToolTip="更多与设置">
                    <FontIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="22"
                        Glyph="&#xE712;" />
                </Button>
            </Border>
        </Grid>

        <Frame
            x:Name="ContentFrame"
            Grid.Row="1"
            Navigated="ContentFrame_Navigated" />
    </Grid>
</Page>
