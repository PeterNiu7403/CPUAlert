<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinMoe.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="ShellRoot"
    Background="#1C1810"
    Loaded="ShellPage_Loaded"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Pixel audit: top chrome ~56 DIP (capsule 38 + vertical air). -->
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="AppTitleBar" Background="Transparent" />

        <Grid
            Height="56"
            Padding="10,0,10,0"
            VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Single floating capsule: logo + 5 routes (Mole glass pill). -->
            <Border
                Grid.Column="1"
                Height="38"
                Padding="4,3"
                VerticalAlignment="Center"
                Background="#B3181510"
                BorderBrush="#554C40"
                BorderThickness="1"
                CornerRadius="19">
                <StackPanel Orientation="Horizontal" Spacing="0">
                    <Button
                        x:Name="BrandButton"
                        Width="30"
                        Height="30"
                        Margin="2,0,3,0"
                        Padding="0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="WinMoe 状态首页"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Click="TopNav_Click"
                        CornerRadius="15"
                        Tag="status"
                        ToolTipService.ToolTip="WinMoe">
                        <Image
                            Width="24"
                            Height="24"
                            Source="ms-appx:///Assets/Brand/winmoe-mark.svg"
                            Stretch="Uniform" />
                    </Button>

                    <Button
                        x:Name="CleanNavButton"
                        MinWidth="54"
                        VerticalAlignment="Center"
                        Click="TopNav_Click"
                        Content="清理"
                        Style="{StaticResource WinMoeTopNavButtonStyle}"
                        Tag="clean" />
                    <Button
                        x:Name="AppsNavButton"
                        MinWidth="54"
                        VerticalAlignment="Center"
                        Click="TopNav_Click"
                        Content="软件"
                        Style="{StaticResource WinMoeTopNavButtonStyle}"
                        Tag="apps" />
                    <Button
                        x:Name="OptimizeNavButton"
                        MinWidth="54"
                        VerticalAlignment="Center"
                        Click="TopNav_Click"
                        Content="优化"
                        Style="{StaticResource WinMoeTopNavButtonStyle}"
                        Tag="optimize" />
                    <Button
                        x:Name="AnalyzeNavButton"
                        MinWidth="54"
                        VerticalAlignment="Center"
                        Click="TopNav_Click"
                        Content="分析"
                        Style="{StaticResource WinMoeTopNavButtonStyle}"
                        Tag="analyze" />
                    <Button
                        x:Name="StatusNavButton"
                        MinWidth="54"
                        VerticalAlignment="Center"
                        Click="TopNav_Click"
                        Content="状态"
                        Style="{StaticResource WinMoeTopNavButtonSelectedStyle}"
                        Tag="status" />
                </StackPanel>
            </Border>

            <!-- Mole has no main-window gear; keep ultra-quiet Windows affordance. -->
            <Button
                x:Name="SettingsButton"
                Grid.Column="2"
                Width="32"
                Height="32"
                Margin="0,0,4,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                AutomationProperties.Name="更多与设置"
                Background="Transparent"
                BorderBrush="Transparent"
                Click="TopNav_Click"
                Opacity="0.35"
                Style="{StaticResource WinMoeIconButtonStyle}"
                Tag="settings"
                ToolTipService.ToolTip="设置">
                <FontIcon FontSize="14" Glyph="&#xE712;" />
            </Button>
        </Grid>

        <Frame
            x:Name="ContentFrame"
            Grid.Row="1"
            Navigated="ContentFrame_Navigated" />
    </Grid>
</Page>
