<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinMoe.Pages.OptimizePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:viewModels="using:WinMoe.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{StaticResource WinMoeBackgroundOptimizeBrush}"
    Loaded="OptimizePage_Loaded"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid MinHeight="640" Padding="24,8,24,28">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16">
                    <Grid
                        Width="280"
                        Height="280"
                        HorizontalAlignment="Center">
                        <Ellipse Width="280" Height="280" Opacity="0.3">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#33E0B03C" Offset="0.55" />
                                    <GradientStop Color="#00221E14" Offset="1" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse x:Name="PlanetVisual" Width="260" Height="260">
                            <Ellipse.RenderTransform>
                                <RotateTransform />
                            </Ellipse.RenderTransform>
                            <Ellipse.Fill>
                                <ImageBrush
                                    ImageSource="ms-appx:///Assets/Hero/optimize.png"
                                    Stretch="UniformToFill" />
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>

                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                        <TextBlock
                            HorizontalAlignment="Center"
                            MaxWidth="420"
                            FontFamily="{StaticResource WinMoeSerifFont}"
                            FontSize="24"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource WinMoeTextBrush}"
                            Text="{Binding TitleText}"
                            TextAlignment="Center"
                            TextWrapping="WrapWholeWords" />
                        <StackPanel
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="6">
                            <Ellipse
                                Width="6"
                                Height="6"
                                VerticalAlignment="Center"
                                Fill="{StaticResource WinMoeGoldBrush}"
                                Opacity="0.9"
                                Visibility="{Binding StepDotVisibility}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontFamily="{StaticResource WinMoeTextFont}"
                                FontSize="12"
                                Foreground="{StaticResource WinMoeDimBrush}"
                                Text="{Binding CurrentStepText}"
                                TextAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Mole: soft glass checklist — muted done, gold active, quiet section stars -->
                    <Border
                        MaxWidth="300"
                        MinWidth="248"
                        HorizontalAlignment="Center"
                        Padding="18,14"
                        Background="#6614100C"
                        BorderBrush="#2A2620"
                        BorderThickness="1"
                        CornerRadius="14"
                        Visibility="{Binding ChecklistVisibility}">
                        <ItemsControl ItemsSource="{Binding ChecklistItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:OptimizeChecklistItem">
                                    <Grid
                                        MinHeight="20"
                                        Margin="0,1.5"
                                        Opacity="{x:Bind RowOpacity, Mode=OneWay}"
                                        ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="10"
                                            Foreground="{x:Bind GlyphBrush, Mode=OneWay}"
                                            Text="{x:Bind Glyph, Mode=OneWay}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            FontWeight="{x:Bind TitleWeight, Mode=OneWay}"
                                            Foreground="{x:Bind TitleBrush, Mode=OneWay}"
                                            Text="{x:Bind Title}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <StackPanel
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="10">
                        <Button
                            MinWidth="160"
                            Command="{Binding PreviewCommand}"
                            Content="{Binding PrimaryActionLabel}"
                            IsEnabled="{Binding CanPreview}"
                            Style="{StaticResource WinMoeGhostPillButtonStyle}"
                            Visibility="{Binding PrimaryActionVisibility}" />
                        <ProgressRing
                            Width="20"
                            Height="20"
                            VerticalAlignment="Center"
                            IsActive="{Binding IsBusy}"
                            Visibility="{Binding ProgressVisibility}" />
                    </StackPanel>

                    <TextBlock
                        HorizontalAlignment="Center"
                        MaxWidth="380"
                        FontSize="11"
                        Foreground="{StaticResource WinMoeDimBrush}"
                        Text="{Binding Summary}"
                        TextAlignment="Center"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
