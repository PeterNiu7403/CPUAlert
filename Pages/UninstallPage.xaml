<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinMoe.Pages.UninstallPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:models="using:WinMoe.Models"
    xmlns:services="using:WinMoe.Services"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:WinMoe.ViewModels"
    x:Name="AppsRoot"
    Background="{StaticResource WinMoeBackgroundSoftwareBrush}"
    mc:Ignorable="d"
    Loaded="UninstallPage_Loaded">

    <Page.Resources>
        <Style x:Key="AppsListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style x:Key="AppsSearchBoxStyle" TargetType="TextBox">
            <Setter Property="Width" Value="140" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="Background" Value="#14100E" />
            <Setter Property="Foreground" Value="{StaticResource WinMoeTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource WinMoeStrokeAppsBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource WinMoeTextFont}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="AppsSmallPillStyle" TargetType="Border">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Background" Value="#463124" />
        </Style>
    </Page.Resources>

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
            <RowDefinition Height="56" />
        </Grid.RowDefinitions>

        <Grid Padding="16,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border
                VerticalAlignment="Center"
                Padding="3"
                Background="#1A120F"
                BorderBrush="{StaticResource WinMoeStrokeAppsBrush}"
                BorderThickness="1"
                CornerRadius="17">
                <StackPanel Orientation="Horizontal" Spacing="1">
                    <Button
                        x:Name="UninstallTabButton"
                        MinWidth="52"
                        Click="AppsTabButton_Click"
                        Content="卸载"
                        Style="{StaticResource WinMoeTopNavButtonSelectedStyle}"
                        Tag="uninstall" />
                    <Button
                        x:Name="UpdatesTabButton"
                        MinWidth="52"
                        Click="AppsTabButton_Click"
                        Content="更新"
                        Style="{StaticResource WinMoeTopNavButtonStyle}"
                        Tag="updates" />
                    <Button
                        x:Name="StartupTabButton"
                        MinWidth="60"
                        Click="AppsTabButton_Click"
                        Content="启动项"
                        Style="{StaticResource WinMoeTopNavButtonStyle}"
                        Tag="startup" />
                </StackPanel>
            </Border>

            <!-- Mole: text-link sort + arrows + refresh + compact search -->
            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="0">
                <Button
                    x:Name="NameSortButton"
                    Command="{Binding SortCommand}"
                    CommandParameter="name"
                    Content="{Binding NameSortLabel}"
                    Style="{StaticResource WinMoeTextLinkStyle}" />
                <Button
                    x:Name="SizeSortButton"
                    Command="{Binding SortCommand}"
                    CommandParameter="size"
                    Content="{Binding SizeSortLabel}"
                    Style="{StaticResource WinMoeTextLinkActiveStyle}" />
                <Button
                    x:Name="SourceSortButton"
                    Command="{Binding SortCommand}"
                    CommandParameter="lastused"
                    Content="{Binding SourceSortLabel}"
                    Style="{StaticResource WinMoeTextLinkStyle}" />
                <Button
                    Command="{Binding LoadCommand}"
                    Style="{StaticResource WinMoeIconButtonStyle}"
                    ToolTipService.ToolTip="刷新">
                    <FontIcon FontSize="12" Glyph="&#xE72C;" />
                </Button>
            </StackPanel>

            <Grid Grid.Column="2" VerticalAlignment="Center" Width="148">
                <TextBox
                    Padding="28,3,10,3"
                    PlaceholderText="搜索"
                    Style="{StaticResource AppsSearchBoxStyle}"
                    Width="148"
                    Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <FontIcon
                    Margin="10,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{StaticResource WinMoeDimBrush}"
                    Glyph="&#xE721;"
                    IsHitTestVisible="False" />
            </Grid>
        </Grid>

        <Border Grid.Row="1" BorderBrush="{StaticResource WinMoeStrokeBrush}" BorderThickness="0,1,0,1">
            <Grid>
                <Grid x:Name="UninstallContent">
                    <ListView
                        Padding="12,8,12,0"
                        ItemContainerStyle="{StaticResource AppsListViewItemStyle}"
                        ItemsSource="{Binding Applications}"
                        SelectedItem="{Binding SelectedApplicationRow, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:ApplicationRowViewModel">
                                <Grid RowSpacing="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid MinHeight="56" Padding="10,8,10,8" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="28" />
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            Width="32"
                                            Height="32"
                                            VerticalAlignment="Center"
                                            Background="#2A1C1A"
                                            CornerRadius="8">
                                            <Grid>
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource WinMoeTextBrush}"
                                                    Text="{x:Bind Initials}"
                                                    Visibility="{x:Bind InitialsVisibility, Mode=OneWay}" />
                                                <Image
                                                    Width="32"
                                                    Height="32"
                                                    Source="{x:Bind IconSource, Mode=OneWay}"
                                                    Stretch="UniformToFill"
                                                    Visibility="{x:Bind IconVisibility, Mode=OneWay}" />
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource WinMoeTextBrush}"
                                                Text="{x:Bind Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock
                                                    FontFamily="{StaticResource WinMoeTextFont}"
                                                    FontSize="11"
                                                    Foreground="{StaticResource WinMoeDimBrush}"
                                                    Text="{x:Bind VersionText}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    FontFamily="{StaticResource WinMoeMonoFont}"
                                                    FontSize="11"
                                                    Foreground="{StaticResource WinMoeDimBrush}"
                                                    Text="{x:Bind SizeText}" />
                                                <TextBlock
                                                    FontFamily="{StaticResource WinMoeTextFont}"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="{x:Bind ActivityBrush, Mode=OneWay}"
                                                    Text="{x:Bind ActivityText, Mode=OneWay}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock
                                            Grid.Column="2"
                                            MaxWidth="220"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource WinMoeMonoFont}"
                                            FontSize="11"
                                            Foreground="{StaticResource WinMoeOrangeBrush}"
                                            Text="{x:Bind RightSummary, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />

                                        <Button
                                            Grid.Column="3"
                                            MinWidth="0"
                                            Padding="8,2"
                                            VerticalAlignment="Center"
                                            Command="{Binding DataContext.ToggleExpandCommand, ElementName=AppsRoot}"
                                            CommandParameter="{x:Bind}"
                                            Content="{x:Bind ChevronText, Mode=OneWay}"
                                            FontSize="11"
                                            Style="{StaticResource WinMoeTextLinkStyle}" />

                                        <Button
                                            Grid.Column="4"
                                            Width="22"
                                            Height="22"
                                            Padding="0"
                                            VerticalAlignment="Center"
                                            Background="{x:Bind CheckBackground, Mode=OneWay}"
                                            BorderBrush="{x:Bind CheckBorder, Mode=OneWay}"
                                            BorderThickness="1.5"
                                            Command="{Binding DataContext.ToggleAppSelectionCommand, ElementName=AppsRoot}"
                                            CommandParameter="{x:Bind}"
                                            CornerRadius="4">
                                            <FontIcon
                                                FontSize="10"
                                                Foreground="White"
                                                Glyph="&#xE73E;"
                                                Visibility="{x:Bind CheckMarkVisibility, Mode=OneWay}" />
                                        </Button>
                                    </Grid>

                                    <Border
                                        Grid.Row="1"
                                        Margin="42,0,10,12"
                                        Padding="14"
                                        Background="#151110"
                                        BorderBrush="{StaticResource WinMoeStrokeAppsBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Visibility="{x:Bind DetailVisibility, Mode=OneWay}">
                                        <Grid RowSpacing="10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="2">
                                                    <TextBlock
                                                        FontSize="13"
                                                        FontWeight="SemiBold"
                                                        Text="{x:Bind Name}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        FontFamily="{StaticResource WinMoeMonoFont}"
                                                        FontSize="11"
                                                        Foreground="{StaticResource WinMoeDimBrush}"
                                                        Text="{x:Bind InstallLocation}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    FontFamily="{StaticResource WinMoeMonoFont}"
                                                    FontSize="11"
                                                    Foreground="{StaticResource WinMoeMutedBrush}"
                                                    Text="{Binding DataContext.LeftoverSelectionText, ElementName=AppsRoot}" />
                                                <Button
                                                    Grid.Column="2"
                                                    Command="{Binding DataContext.SelectAllLeftoversCommand, ElementName=AppsRoot}"
                                                    Content="全选"
                                                    FontSize="12"
                                                    Style="{StaticResource WinMoeTextLinkActiveStyle}" />
                                            </Grid>

                                            <TextBlock
                                                Grid.Row="1"
                                                FontSize="11"
                                                Foreground="{StaticResource WinMoeDimBrush}"
                                                Text="{Binding DataContext.LeftoverSummary, ElementName=AppsRoot}" />

                                            <ListView
                                                Grid.Row="2"
                                                MaxHeight="200"
                                                ItemContainerStyle="{StaticResource AppsListViewItemStyle}"
                                                ItemsSource="{Binding DataContext.Leftovers, ElementName=AppsRoot}"
                                                SelectionMode="None">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate x:DataType="models:LeftoverCandidate">
                                                        <Grid MinHeight="32" ColumnSpacing="10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="28" />
                                                                <ColumnDefinition Width="120" />
                                                                <ColumnDefinition Width="72" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox
                                                                MinWidth="0"
                                                                IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                                            <TextBlock
                                                                Grid.Column="1"
                                                                VerticalAlignment="Center"
                                                                FontSize="12"
                                                                FontWeight="SemiBold"
                                                                Foreground="{StaticResource WinMoeMutedBrush}"
                                                                Text="{x:Bind Category}"
                                                                TextTrimming="CharacterEllipsis" />
                                                            <TextBlock
                                                                Grid.Column="2"
                                                                VerticalAlignment="Center"
                                                                FontFamily="{StaticResource WinMoeMonoFont}"
                                                                FontSize="11"
                                                                Foreground="{StaticResource WinMoeDimBrush}"
                                                                Text="{x:Bind SizeText}" />
                                                            <TextBlock
                                                                Grid.Column="3"
                                                                VerticalAlignment="Center"
                                                                FontFamily="{StaticResource WinMoeMonoFont}"
                                                                FontSize="11"
                                                                Foreground="{StaticResource WinMoeDimBrush}"
                                                                Text="{x:Bind Path}"
                                                                TextTrimming="CharacterEllipsis" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                        </Grid>
                                    </Border>

                                    <Border
                                        Height="1"
                                        Margin="52,0,10,0"
                                        VerticalAlignment="Bottom"
                                        Background="#332622" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- Mole Updates: quiet empty surface, never auto-installs -->
                <Grid x:Name="UpdatesContent" Visibility="Collapsed">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="420"
                        Spacing="14">
                        <FontIcon
                            HorizontalAlignment="Center"
                            FontSize="36"
                            Foreground="{StaticResource WinMoeDimBrush}"
                            Glyph="&#xE895;" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="22"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource WinMoeMutedBrush}"
                            Text="{Binding UpdatesHeadline}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="13"
                            Foreground="{StaticResource WinMoeDimBrush}"
                            Text="{Binding UpdatesSummary}"
                            TextAlignment="Center"
                            TextWrapping="WrapWholeWords" />
                        <Button
                            HorizontalAlignment="Center"
                            MinWidth="140"
                            Click="UnsupportedAppsFeatureButton_Click"
                            Content="重新检查"
                            Style="{StaticResource WinMoeGhostPillButtonStyle}" />
                    </StackPanel>
                </Grid>

                <!-- Startup: read-only Windows Run keys + Startup folders -->
                <Grid x:Name="StartupContent" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Padding="16,0" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource WinMoeMutedBrush}"
                            Text="{Binding StartupHeadline}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{StaticResource WinMoeDimBrush}"
                            Text="{Binding StartupSummary}" />
                    </Grid>
                    <ListView
                        Grid.Row="1"
                        Padding="12,0,12,12"
                        ItemContainerStyle="{StaticResource AppsListViewItemStyle}"
                        ItemsSource="{Binding StartupItems}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="services:StartupItem">
                                <Grid MinHeight="48" Padding="10,8" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Foreground="{StaticResource WinMoeGoldBrush}"
                                        Glyph="&#xE7C1;" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontFamily="{StaticResource WinMoeMonoFont}"
                                            FontSize="11"
                                            Foreground="{StaticResource WinMoeDimBrush}"
                                            Text="{x:Bind ShortCommand}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{x:Bind Command}" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Right"
                                        FontSize="11"
                                        Foreground="{StaticResource WinMoeDimBrush}"
                                        Text="{x:Bind Source}"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </Border>

        <!-- Mole sticky footer: icon stack · N apps · size · Clear selection · Remove N -->
        <Grid Grid.Row="2" Padding="14,0,16,0" Background="#120E0D" MinHeight="56">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="10">
                <ItemsControl
                    VerticalAlignment="Center"
                    ItemsSource="{Binding SelectedFooterApps}"
                    Visibility="{Binding SelectedIconsVisibility}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="-6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:ApplicationRowViewModel">
                            <Border
                                Width="22"
                                Height="22"
                                Background="#2A1C1A"
                                BorderBrush="#120E0D"
                                BorderThickness="1.5"
                                CornerRadius="6"
                                ToolTipService.ToolTip="{x:Bind Name}">
                                <Grid>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="9"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource WinMoeTextBrush}"
                                        Text="{x:Bind Initials}"
                                        Visibility="{x:Bind InitialsVisibility, Mode=OneWay}" />
                                    <Image
                                        Width="18"
                                        Height="18"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Source="{x:Bind IconSource, Mode=OneWay}"
                                        Stretch="UniformToFill"
                                        Visibility="{x:Bind IconVisibility, Mode=OneWay}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource WinMoeTextFont}"
                    FontSize="12"
                    Foreground="{StaticResource WinMoeMutedBrush}"
                    Text="{Binding AppsCountText}" />
                <Button
                    VerticalAlignment="Center"
                    Command="{Binding ClearSelectionCommand}"
                    Content="清除选择"
                    FontSize="12"
                    Foreground="{StaticResource WinMoeOrangeBrush}"
                    Style="{StaticResource WinMoeTextLinkStyle}"
                    Visibility="{Binding ClearSelectionVisibility}" />
                <Button
                    VerticalAlignment="Center"
                    Click="RemoveLeftoversButton_Click"
                    Content="移入回收站"
                    FontSize="12"
                    IsEnabled="{Binding CanRemoveSelectedLeftovers}"
                    Style="{StaticResource WinMoeTextLinkStyle}"
                    Visibility="{Binding ClearSelectionVisibility}" />
            </StackPanel>
            <Button
                Grid.Column="1"
                MinWidth="132"
                MinHeight="38"
                VerticalAlignment="Center"
                Click="UninstallButton_Click"
                Content="{Binding RemoveButtonLabel}"
                IsEnabled="{Binding CanLaunchUninstaller}"
                Style="{StaticResource WinMoePillButtonStyle}" />
        </Grid>
    </Grid>
</Page>
