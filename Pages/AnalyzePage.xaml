<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinMoe.Pages.AnalyzePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:viewModels="using:WinMoe.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{StaticResource WinMoeBackgroundAnalyzeBrush}"
    mc:Ignorable="d"
    Loaded="AnalyzePage_Loaded"
    SizeChanged="AnalyzePage_SizeChanged">

    <Grid x:Name="AnalyzeRoot" ColumnSpacing="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left rail: small Jupiter + folder list (Mole Analyze). -->
        <Grid Padding="16,16,12,12" RowSpacing="14" Background="{StaticResource WinMoeBackgroundAnalyzeRailBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel HorizontalAlignment="Center" Spacing="10">
                <Ellipse x:Name="PlanetVisual" Width="90" Height="90">
                    <Ellipse.RenderTransform>
                        <RotateTransform />
                    </Ellipse.RenderTransform>
                    <Ellipse.Fill>
                        <ImageBrush
                            ImageSource="ms-appx:///Assets/Hero/analyze.png"
                            Stretch="UniformToFill" />
                    </Ellipse.Fill>
                </Ellipse>
                <TextBlock
                    HorizontalAlignment="Center"
                    FontFamily="{StaticResource WinMoeTextFont}"
                    FontSize="11"
                    Foreground="{StaticResource WinMoeMutedBrush}"
                    Text="{Binding AnalyzeOverviewText}"
                    TextAlignment="Center"
                    TextWrapping="WrapWholeWords" />
                <TextBlock
                    HorizontalAlignment="Left"
                    Margin="4,4,0,0"
                    FontSize="10"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource WinMoeDimBrush}"
                    Text="当前文件夹" />
            </StackPanel>

            <ListView
                x:Name="SidebarList"
                Grid.Row="1"
                IsItemClickEnabled="True"
                ItemClick="SidebarList_ItemClick"
                ItemsSource="{Binding SidebarItems}"
                SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,1" />
                        <Setter Property="MinHeight" Value="44" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:AnalyzeSidebarItemViewModel">
                        <Grid
                            MinHeight="44"
                            Padding="2,2"
                            ColumnSpacing="10"
                            RightTapped="AnalyzeTarget_RightTapped"
                            Tag="{x:Bind Path}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="#C9A070"
                                Glyph="&#xE8B7;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind Name}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    FontFamily="{StaticResource WinMoeMonoFont}"
                                    FontSize="11"
                                    Foreground="{StaticResource WinMoeDimBrush}"
                                    Text="{x:Bind SizeText}" />
                            </StackPanel>
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="{StaticResource WinMoeDimBrush}"
                                Text="›" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Grid.Row="2" Spacing="4">
                <TextBlock
                    FontSize="11"
                    Foreground="{StaticResource WinMoeDimBrush}"
                    Text="单击进入 · 右键：打开 / 回收站"
                    TextWrapping="WrapWholeWords" />
                <TextBlock
                    FontSize="10"
                    Foreground="{StaticResource WinMoeDimBrush}"
                    Text="{Binding ActionStatusText}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="WrapWholeWords" />
            </StackPanel>
        </Grid>

        <Border Grid.Column="1" Background="#2A221A" />

        <Grid Grid.Column="2" Background="{StaticResource WinMoeBackgroundAnalyzeBrush}" RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Mole: breadcrumb left · Current / Disk used·total + mini bar + refresh right -->
            <Grid Padding="14,0,12,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">
                    <Button
                        MinWidth="0"
                        Padding="4,2"
                        Click="GoUpButton_Click"
                        Style="{StaticResource WinMoeTextLinkStyle}"
                        ToolTipService.ToolTip="返回上级">
                        <FontIcon FontSize="12" Glyph="&#xE72B;" />
                    </Button>
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{StaticResource WinMoeDimBrush}"
                        Glyph="&#xEDA2;" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{StaticResource WinMoeMutedBrush}"
                        Text="{Binding BreadcrumbText}"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="{Binding RootPath}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="10">
                    <Border
                        Width="48"
                        Height="4"
                        VerticalAlignment="Center"
                        Background="#2A221A"
                        CornerRadius="2">
                        <Border
                            Width="{Binding DiskUsageBarWidth}"
                            Height="4"
                            HorizontalAlignment="Left"
                            Background="#C9A070"
                            CornerRadius="2" />
                    </Border>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource WinMoeMonoFont}"
                        FontSize="11"
                        Foreground="{StaticResource WinMoeDimBrush}"
                        Text="{Binding HeaderMetricsText}" />
                </StackPanel>

                <Button
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="扫描磁盘空间"
                    Command="{Binding ScanCommand}"
                    Style="{StaticResource WinMoeIconButtonStyle}">
                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                </Button>

                <Border
                    Grid.ColumnSpan="3"
                    VerticalAlignment="Bottom"
                    BorderBrush="#2A221A"
                    BorderThickness="0,0,0,1" />
            </Grid>

            <Grid
                x:Name="TreemapViewport"
                Grid.Row="1"
                Padding="12,10,12,12"
                Loaded="TreemapViewport_Loaded"
                SizeChanged="TreemapViewport_SizeChanged">
                <ItemsControl
                    Width="{Binding TreemapCanvasWidth}"
                    Height="{Binding TreemapCanvasHeight}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    ItemsSource="{Binding TreemapTiles}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas
                                Width="{Binding TreemapCanvasWidth}"
                                Height="{Binding TreemapCanvasHeight}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:DiskTreemapTileViewModel">
                            <Border
                                Width="{x:Bind Width}"
                                Height="{x:Bind Height}"
                                Padding="10"
                                Background="{x:Bind FillBrush}"
                                BorderBrush="#1A130F"
                                BorderThickness="2.5"
                                CornerRadius="3"
                                RightTapped="AnalyzeTarget_RightTapped"
                                Tapped="TreemapTile_Tapped"
                                Tag="{x:Bind Path}">
                                <Border.RenderTransform>
                                    <TranslateTransform X="{x:Bind X}" Y="{x:Bind Y}" />
                                </Border.RenderTransform>
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Opacity="{x:Bind LabelOpacity}"
                                    Spacing="4">
                                    <FontIcon
                                        FontSize="16"
                                        Foreground="#F5EDE0"
                                        Glyph="&#xE8B7;"
                                        Visibility="{x:Bind IconVisibility}" />
                                    <TextBlock
                                        MaxLines="2"
                                        HorizontalAlignment="Center"
                                        FontSize="{x:Bind FontSize}"
                                        FontWeight="SemiBold"
                                        Foreground="#F5EDE0"
                                        Text="{x:Bind Name}"
                                        TextAlignment="Center"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="WrapWholeWords" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontFamily="{StaticResource WinMoeMonoFont}"
                                        FontSize="12"
                                        Foreground="#F5EDE0"
                                        Text="{x:Bind SizeText}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>
    </Grid>
</Page>
