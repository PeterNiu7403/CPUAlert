<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinMoe.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:models="using:WinMoe.Models"
    xmlns:services="using:WinMoe.Services"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{StaticResource WinMoeBackgroundBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="SettingsFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource WinMoeMonoFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource WinMoeMutedBrush}" />
        </Style>

        <Style x:Key="SettingsInputTextBoxStyle" TargetType="TextBox">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Background" Value="#181815" />
            <Setter Property="Foreground" Value="{StaticResource WinMoeTextBrush}" />
            <Setter Property="BorderBrush" Value="#56524A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="{StaticResource WinMoeMonoFont}" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="SettingsToggleSwitchStyle" TargetType="ToggleSwitch">
            <Setter Property="Foreground" Value="{StaticResource WinMoeMutedBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource WinMoeMonoFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="OnContent" Value="开" />
            <Setter Property="OffContent" Value="关" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <Grid Padding="24,18,24,24" RowSpacing="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="设置" />
                    <TextBlock
                        FontFamily="{StaticResource WinMoeMonoFont}"
                        Foreground="{StaticResource WinMoeDimBrush}"
                        Text="{Binding SettingsStatus}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <Button
                    Grid.Column="1"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource WinMoeSecondaryPillButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                        <TextBlock Text="刷新" />
                    </StackPanel>
                </Button>

                <Button
                    Grid.Column="2"
                    Command="{Binding SaveSettingsCommand}"
                    Style="{StaticResource WinMoePillButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            FontSize="14"
                            Foreground="#111111"
                            Glyph="&#xE74E;" />
                        <TextBlock
                            Foreground="#111111"
                            Text="保存" />
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Grid.Row="1" ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="0.95*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource WinMoeCardBorderStyle}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.ColumnSpan="2"
                            Foreground="{StaticResource WinMoeGreenBrush}"
                            Style="{StaticResource WinMoeLabelTextStyle}"
                            Text="引擎" />

                        <TextBlock Grid.Row="1" Foreground="{StaticResource WinMoeMutedBrush}" Text="状态" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            Text="{Binding EngineStatus}"
                            TextWrapping="Wrap" />

                        <TextBlock Grid.Row="2" Foreground="{StaticResource WinMoeMutedBrush}" Text="类型" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            FontFamily="{StaticResource WinMoeMonoFont}"
                            Foreground="{StaticResource WinMoeGoldBrush}"
                            Text="{Binding EngineKind}" />

                        <TextBlock Grid.Row="3" Foreground="{StaticResource WinMoeMutedBrush}" Text="路径" />
                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="1"
                            FontFamily="{StaticResource WinMoeMonoFont}"
                            Foreground="{StaticResource WinMoeDimBrush}"
                            Text="{Binding EnginePath}"
                            TextWrapping="Wrap" />

                        <TextBlock Grid.Row="4" Foreground="{StaticResource WinMoeMutedBrush}" Text="安装说明" />
                        <TextBlock
                            Grid.Row="4"
                            Grid.Column="1"
                            Foreground="{StaticResource WinMoeDimBrush}"
                            Text="{Binding EngineInstallHint}"
                            TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource WinMoeCardBorderStyle}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.ColumnSpan="2"
                            Foreground="{StaticResource WinMoeBlueBrush}"
                            Style="{StaticResource WinMoeLabelTextStyle}"
                            Text="代理" />

                        <StackPanel Grid.Row="1" Spacing="8">
                            <TextBlock Style="{StaticResource SettingsFieldLabelStyle}" Text="HTTP REST 服务" />
                            <ToggleSwitch
                                IsOn="{Binding HttpServerEnabled, Mode=TwoWay}"
                                Style="{StaticResource SettingsToggleSwitchStyle}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Row="1"
                            Grid.Column="1"
                            Spacing="8">
                            <TextBlock Style="{StaticResource SettingsFieldLabelStyle}" Text="端口" />
                            <TextBox
                                InputScope="Number"
                                Style="{StaticResource SettingsInputTextBoxStyle}"
                                Text="{Binding HttpServerPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel
                            Grid.Row="2"
                            Grid.ColumnSpan="2"
                            Spacing="8">
                            <TextBlock Style="{StaticResource SettingsFieldLabelStyle}" Text="MCP 破坏性操作" />
                            <ToggleSwitch
                                IsOn="{Binding McpDestructiveActionsEnabled, Mode=TwoWay}"
                                Style="{StaticResource SettingsToggleSwitchStyle}" />
                        </StackPanel>

                        <TextBlock Grid.Row="3" Foreground="{StaticResource WinMoeMutedBrush}" Text="服务地址" />
                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="1"
                            FontFamily="{StaticResource WinMoeMonoFont}"
                            Foreground="{StaticResource WinMoeDimBrush}"
                            Text="{Binding McpEndpoint}"
                            TextWrapping="Wrap" />
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource WinMoeCardBorderStyle}">
                <Grid ColumnSpacing="18" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.ColumnSpan="3"
                        Foreground="{StaticResource WinMoeGoldBrush}"
                        Style="{StaticResource WinMoeLabelTextStyle}"
                        Text="行为" />

                    <StackPanel Grid.Row="1" Spacing="8">
                        <TextBlock Style="{StaticResource SettingsFieldLabelStyle}" Text="采样间隔（秒）" />
                        <TextBox
                            InputScope="Number"
                            Style="{StaticResource SettingsInputTextBoxStyle}"
                            Text="{Binding SamplingIntervalSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="1"
                        Spacing="8">
                        <TextBlock Style="{StaticResource SettingsFieldLabelStyle}" Text="历史保留（天）" />
                        <TextBox
                            InputScope="Number"
                            Style="{StaticResource SettingsInputTextBoxStyle}"
                            Text="{Binding HistoryRetentionDays, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="2"
                        Spacing="8">
                        <TextBlock Style="{StaticResource SettingsFieldLabelStyle}" Text="托盘图标" />
                        <ToggleSwitch
                            IsOn="{Binding TrayIconEnabled, Mode=TwoWay}"
                            Style="{StaticResource SettingsToggleSwitchStyle}" />
                    </StackPanel>

                    <StackPanel
                        Grid.Row="2"
                        Spacing="8">
                        <TextBlock Style="{StaticResource SettingsFieldLabelStyle}" Text="分享崩溃报告与匿名统计" />
                        <ToggleSwitch
                            IsOn="{Binding TelemetryEnabled, Mode=TwoWay}"
                            Style="{StaticResource SettingsToggleSwitchStyle}" />
                    </StackPanel>

                    <TextBlock
                        Grid.Row="3"
                        Grid.ColumnSpan="3"
                        FontFamily="{StaticResource WinMoeMonoFont}"
                        Foreground="{StaticResource WinMoeDimBrush}"
                        Text="采样、托盘显示、REST 服务与端口、MCP 破坏性开关和遥测设置保存后立即生效。回环 MCP 桥仅监听本机。遥测为匿名、可关闭，且仅在正式签名版本中发送。"
                        TextWrapping="Wrap" />
                </Grid>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource WinMoeCardBorderStyle}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.ColumnSpan="2"
                        Foreground="{StaticResource WinMoePurpleBrush}"
                        Style="{StaticResource WinMoeLabelTextStyle}"
                        Text="本地文件" />

                    <TextBlock Grid.Row="1" Foreground="{StaticResource WinMoeMutedBrush}" Text="设置" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        FontFamily="{StaticResource WinMoeMonoFont}"
                        Foreground="{StaticResource WinMoeDimBrush}"
                        Text="{Binding SettingsPath}"
                        TextWrapping="Wrap" />

                    <TextBlock Grid.Row="2" Foreground="{StaticResource WinMoeMutedBrush}" Text="遥测历史" />
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="1"
                        FontFamily="{StaticResource WinMoeMonoFont}"
                        Foreground="{StaticResource WinMoeDimBrush}"
                        Text="{Binding TelemetryHistoryPath}"
                        TextWrapping="Wrap" />

                    <TextBlock Grid.Row="3" Foreground="{StaticResource WinMoeMutedBrush}" Text="活动记录" />
                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="1"
                        FontFamily="{StaticResource WinMoeMonoFont}"
                        Foreground="{StaticResource WinMoeDimBrush}"
                        Text="{Binding ActivityHistoryPath}"
                        TextWrapping="Wrap" />
                </Grid>
            </Border>

            <Border Grid.Row="4" Style="{StaticResource WinMoeCardBorderStyle}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="4">
                            <TextBlock
                                Foreground="{StaticResource WinMoeOrangeBrush}"
                                Style="{StaticResource WinMoeLabelTextStyle}"
                                Text="最近活动" />
                            <TextBlock
                                FontFamily="{StaticResource WinMoeMonoFont}"
                                Foreground="{StaticResource WinMoeDimBrush}"
                                Text="{Binding HistorySummary}" />
                        </StackPanel>

                        <Button
                            Grid.Column="1"
                            Command="{Binding LoadHistoryCommand}"
                            Style="{StaticResource WinMoeSecondaryPillButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE81C;" />
                                <TextBlock Text="载入活动" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBlock
                        Grid.Row="1"
                        FontFamily="{StaticResource WinMoeMonoFont}"
                        Foreground="{StaticResource WinMoeDimBrush}"
                        Text="{Binding McpStdioCommand}"
                        TextWrapping="Wrap" />

                    <ListView
                        Grid.Row="2"
                        ItemsSource="{Binding HistoryEntries}"
                        MaxHeight="280">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:OperationHistoryEntry">
                                <Grid MinHeight="58" ColumnSpacing="12" Padding="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="152" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="116" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        FontFamily="{StaticResource WinMoeMonoFont}"
                                        Foreground="{StaticResource WinMoeMutedBrush}"
                                        Text="{x:Bind TimestampText}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        FontFamily="{StaticResource WinMoeMonoFont}"
                                        Foreground="{StaticResource WinMoeDimBrush}"
                                        Text="{x:Bind Source}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind Operation}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="3"
                                        Foreground="{StaticResource WinMoeGoldBrush}"
                                        Text="{x:Bind services:AppActivityFormatter.FormatOperationResult(Succeeded)}" />
                                    <TextBlock
                                        Grid.Column="4"
                                        FontFamily="{StaticResource WinMoeMonoFont}"
                                        Foreground="{StaticResource WinMoeDimBrush}"
                                        Text="{x:Bind Summary}"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
