<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinMoe.Pages.CleanupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:models="using:WinMoe.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{StaticResource WinMoeBackgroundGreenBrush}"
    Loaded="CleanupPage_Loaded"
    mc:Ignorable="d">

    <ScrollViewer>
        <Grid MinHeight="760" Padding="24,28,24,24" RowSpacing="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="480" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="220" />
            </Grid.RowDefinitions>

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="24">
                <Border Width="360" Height="225" CornerRadius="28">
                    <Image
                        Source="ms-appx:///Assets/Hero/clean.png"
                        Stretch="UniformToFill" />
                </Border>

                <StackPanel HorizontalAlignment="Center" Spacing="10">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontFamily="{StaticResource WinMoeSerifFont}"
                        FontSize="42"
                        FontWeight="SemiBold"
                        Text="清理" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontFamily="{StaticResource WinMoeSerifFont}"
                        FontSize="20"
                        FontStyle="Italic"
                        Foreground="{StaticResource WinMoeMutedBrush}"
                        Text="让空间重新呼吸" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontFamily="{StaticResource WinMoeMonoFont}"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="{StaticResource WinMoeGoldBrush}"
                        Text="{Binding PendingMessage}" />
                </StackPanel>

                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="16">
                    <Button
                        Click="CleanButton_Click"
                        Content="执行清理（安全合约完成后开放）"
                        IsEnabled="False"
                        Style="{StaticResource WinMoePillButtonStyle}" />
                    <Button
                        Command="{Binding ScanCommand}"
                        Content="扫描并预览"
                        IsEnabled="{Binding CanPreview}"
                        Style="{StaticResource WinMoeSecondaryPillButtonStyle}" />
                    <ProgressRing
                        Width="28"
                        Height="28"
                        IsActive="{Binding IsBusy}" />
                </StackPanel>

                <TextBlock
                    HorizontalAlignment="Center"
                    FontFamily="{StaticResource WinMoeMonoFont}"
                    Foreground="{StaticResource WinMoeDimBrush}"
                    Text="{Binding Summary}" />
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource WinMoeCardBorderStyle}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="280" />
                    </Grid.RowDefinitions>
                    <TextBlock Foreground="{StaticResource WinMoeBlueBrush}" Style="{StaticResource WinMoeLabelTextStyle}" Text="可清理项目预览" />
                    <ListView Grid.Row="1" ItemsSource="{Binding PreviewItems}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:CleanupPreviewItem">
                                <Grid MinHeight="52" ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind Category}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" FontFamily="{StaticResource WinMoeMonoFont}" Foreground="{StaticResource WinMoeMutedBrush}" Text="{x:Bind SizeText}" />
                                    <TextBlock Grid.Column="2" FontFamily="{StaticResource WinMoeMonoFont}" Foreground="{StaticResource WinMoeDimBrush}" Text="{x:Bind Path}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <TextBox
                Grid.Row="2"
                AcceptsReturn="True"
                FontFamily="{StaticResource WinMoeMonoFont}"
                IsReadOnly="True"
                Text="{Binding OutputText, Mode=OneWay}"
                TextWrapping="Wrap" />
        </Grid>
    </ScrollViewer>
</Page>
