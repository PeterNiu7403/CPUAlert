    "cleanup.footnote" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The estimate is physical footprint, not a promise of reclaimed memory. Shared pages, compression, and application behavior affect the result." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "估算值是进程物理占用，不代表保证释放的容量；共享页、压缩和应用行为都会影响结果。" } } } },
