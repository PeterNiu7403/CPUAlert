<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="WinMoeColorBackground">#121217</Color>
    <Color x:Key="WinMoeColorBackgroundGreen">#151A2B</Color>
    <Color x:Key="WinMoeColorBackgroundBlue">#2D2017</Color>
    <Color x:Key="WinMoeColorBackgroundBrown">#2A261F</Color>
    <Color x:Key="WinMoeColorBackgroundPurple">#221F18</Color>
    <Color x:Key="WinMoeColorBackgroundSoftware">#211819</Color>
    <Color x:Key="WinMoeColorPanel">#1D1D22</Color>
    <Color x:Key="WinMoeColorPanelWarm">#221C16</Color>
    <Color x:Key="WinMoeColorStroke">#343238</Color>
    <Color x:Key="WinMoeColorText">#F3ECDD</Color>
    <Color x:Key="WinMoeColorMuted">#B5AEA2</Color>
    <Color x:Key="WinMoeColorDim">#807A72</Color>
    <Color x:Key="WinMoeColorAccent">#D9A066</Color>
    <Color x:Key="WinMoeColorOnAccent">#241B12</Color>
    <Color x:Key="WinMoeColorGreen">#57D58E</Color>
    <Color x:Key="WinMoeColorGold">#E6A93C</Color>
    <Color x:Key="WinMoeColorOrange">#F2894E</Color>
    <Color x:Key="WinMoeColorBlue">#5AA8F0</Color>
    <Color x:Key="WinMoeColorRed">#F0604E</Color>
    <Color x:Key="WinMoeColorPurple">#8E84F0</Color>

    <SolidColorBrush x:Key="WinMoeBackgroundBrush" Color="{StaticResource WinMoeColorBackground}" />
    <SolidColorBrush x:Key="WinMoeBackgroundGreenBrush" Color="{StaticResource WinMoeColorBackgroundGreen}" />
    <SolidColorBrush x:Key="WinMoeBackgroundBlueBrush" Color="{StaticResource WinMoeColorBackgroundBlue}" />
    <SolidColorBrush x:Key="WinMoeBackgroundBrownBrush" Color="{StaticResource WinMoeColorBackgroundBrown}" />
    <SolidColorBrush x:Key="WinMoeBackgroundPurpleBrush" Color="{StaticResource WinMoeColorBackgroundPurple}" />
    <SolidColorBrush x:Key="WinMoeBackgroundSoftwareBrush" Color="{StaticResource WinMoeColorBackgroundSoftware}" />
    <SolidColorBrush x:Key="WinMoePanelBrush" Color="{StaticResource WinMoeColorPanel}" />
    <SolidColorBrush x:Key="WinMoePanelWarmBrush" Color="{StaticResource WinMoeColorPanelWarm}" />
    <SolidColorBrush x:Key="WinMoeStrokeBrush" Color="{StaticResource WinMoeColorStroke}" />
    <SolidColorBrush x:Key="WinMoeTextBrush" Color="{StaticResource WinMoeColorText}" />
    <SolidColorBrush x:Key="WinMoeMutedBrush" Color="{StaticResource WinMoeColorMuted}" />
    <SolidColorBrush x:Key="WinMoeDimBrush" Color="{StaticResource WinMoeColorDim}" />
    <SolidColorBrush x:Key="WinMoeAccentBrush" Color="{StaticResource WinMoeColorAccent}" />
    <SolidColorBrush x:Key="WinMoeOnAccentBrush" Color="{StaticResource WinMoeColorOnAccent}" />
    <SolidColorBrush x:Key="WinMoeGreenBrush" Color="{StaticResource WinMoeColorGreen}" />
    <SolidColorBrush x:Key="WinMoeGoldBrush" Color="{StaticResource WinMoeColorGold}" />
    <SolidColorBrush x:Key="WinMoeOrangeBrush" Color="{StaticResource WinMoeColorOrange}" />
    <SolidColorBrush x:Key="WinMoeBlueBrush" Color="{StaticResource WinMoeColorBlue}" />
    <SolidColorBrush x:Key="WinMoeRedBrush" Color="{StaticResource WinMoeColorRed}" />
    <SolidColorBrush x:Key="WinMoePurpleBrush" Color="{StaticResource WinMoeColorPurple}" />
    <SolidColorBrush x:Key="WinMoeWhitePillBrush" Color="#FFFDF8" />

    <FontFamily x:Key="WinMoeTextFont">Segoe UI Variable Text, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="WinMoeMonoFont">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="WinMoeSerifFont">Segoe UI Variable Display, Microsoft YaHei UI</FontFamily>

    <Style x:Key="TitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource WinMoeSerifFont}" />
        <Setter Property="FontSize" Value="42" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource WinMoeTextBrush}" />
    </Style>

    <Style x:Key="SubtitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource WinMoeMonoFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource WinMoeMutedBrush}" />
    </Style>

    <Style x:Key="WinMoeLabelTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource WinMoeMonoFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="80" />
        <Setter Property="Foreground" Value="{StaticResource WinMoeMutedBrush}" />
    </Style>

    <Style x:Key="WinMoeMetricTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource WinMoeTextBrush}" />
    </Style>

    <Style x:Key="WinMoeCardBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="20" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Background" Value="{StaticResource WinMoePanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource WinMoeStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="WinMoePillButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="24,8" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="FontFamily" Value="{StaticResource WinMoeMonoFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Background" Value="{StaticResource WinMoeWhitePillBrush}" />
        <Setter Property="Foreground" Value="Black" />
        <Setter Property="BorderBrush" Value="{StaticResource WinMoeWhitePillBrush}" />
    </Style>

    <Style x:Key="WinMoeSecondaryPillButtonStyle" TargetType="Button" BasedOn="{StaticResource WinMoePillButtonStyle}">
        <Setter Property="Background" Value="{StaticResource WinMoePanelBrush}" />
        <Setter Property="Foreground" Value="{StaticResource WinMoeTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource WinMoeStrokeBrush}" />
    </Style>

    <Style x:Key="WinMoeTopNavButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Padding" Value="18,6" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="FontFamily" Value="{StaticResource WinMoeTextFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource WinMoeMutedBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style x:Key="WinMoeTopNavButtonSelectedStyle" TargetType="Button" BasedOn="{StaticResource WinMoeTopNavButtonStyle}">
        <Setter Property="Background" Value="{StaticResource WinMoeWhitePillBrush}" />
        <Setter Property="Foreground" Value="Black" />
    </Style>

    <Style x:Key="WinMoeIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="21" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource WinMoeMutedBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style x:Key="WinMoeIconButtonSelectedStyle" TargetType="Button" BasedOn="{StaticResource WinMoeIconButtonStyle}">
        <Setter Property="Background" Value="{StaticResource WinMoeWhitePillBrush}" />
        <Setter Property="Foreground" Value="Black" />
    </Style>

    <Style TargetType="Page">
        <Setter Property="Background" Value="{StaticResource WinMoeBackgroundBrush}" />
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource WinMoeTextBrush}" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="#141412" />
        <Setter Property="Foreground" Value="{StaticResource WinMoeTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource WinMoeStrokeBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource WinMoeMonoFont}" />
    </Style>

    <Style TargetType="ListView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource WinMoeTextBrush}" />
    </Style>

    <Style TargetType="TreeView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource WinMoeTextBrush}" />
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{StaticResource WinMoeGreenBrush}" />
        <Setter Property="Background" Value="#343331" />
        <Setter Property="MinHeight" Value="8" />
        <Setter Property="CornerRadius" Value="5" />
    </Style>
</ResourceDictionary>
